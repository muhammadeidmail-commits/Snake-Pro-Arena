import streamlit as st
import streamlit.components.v1 as components

st.set_page_config(page_title="دودة الأبطال - Hero Snake", layout="centered")

st.markdown("<h1 style='text-align: center; color: #A855F7;'>🐍 دودة الأبطال - Hero Snake</h1>", unsafe_allow_html=True)

# كود اللعبة بالكامل بلغة JavaScript لضمان السرعة والتحكم
snake_game_code = """
<canvas id="gameCanvas" width="400" height="400" style="background:#0A0A0A; border:2px solid #06B6D4;"></canvas>
<script>
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");
    let snake = [{x: 10, y: 10}];
    let food = {x: 15, y: 15};
    let dx = 1, dy = 0;
    
    function draw() {
        ctx.fillStyle = "#0A0A0A"; ctx.fillRect(0, 0, 400, 400);
        
        ctx.fillStyle = "#FF0000"; // الطعام
        ctx.fillRect(food.x*20, food.y*20, 18, 18);
        
        ctx.fillStyle = "#06B6D4"; // الدودة
        snake.forEach(part => ctx.fillRect(part.x*20, part.y*20, 18, 18));
        
        let head = {x: snake[0].x + dx, y: snake[0].y + dy};
        snake.unshift(head);
        if(head.x === food.x && head.y === food.y) food = {x: Math.floor(Math.random()*20), y: Math.floor(Math.random()*20)};
        else snake.pop();
        
        if(head.x<0 || head.x>19 || head.y<0 || head.y>19) snake = [{x: 10, y: 10}];
        setTimeout(draw, 100);
    }
    document.addEventListener("keydown", e => {
        if(e.key==="ArrowUp") {dx=0; dy=-1;}
        if(e.key==="ArrowDown") {dx=0; dy=1;}
        if(e.key==="ArrowLeft") {dx=-1; dy=0;}
        if(e.key==="ArrowRight") {dx=1; dy=0;}
    });
    draw();
</script>
"""

components.html(snake_game_code, width=410, height=410)
st.write("### 🎮 استخدم أسهم لوحة المفاتيح للتحكم!")
